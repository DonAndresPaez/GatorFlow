# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# C++ build output: generated, machine-specific, and big
KinectReader/build/
KinectReader/out/
*.exe
*.pdb
*.ilk
*.obj
*.sln
*.vcxproj*

# Panel-method and flow-field caches: rebuilt by themselves from the STL (aero/panel.py, aero/flowlines.py). surrogate.npz IS committed.
models/*/aero/panel_*.npz
models/*/aero/field_*.npz
# OBJ copies of the STLs for TouchDesigner's File In SOP (load_setup.py writes them)
models/*/aero/*.obj

# Generated calibration: belongs to one camera in one mounting (see calibration/README.md)
calibration/*/

# TouchDesigner backups
touchdesigner/Backup/
*.[0-9]*.toe
CrashAutoSave*

# Printables, snapshots and other generated images
tools/output/
*.png
!docs/*.png

.DS_Store
Thumbs.db
.vscode/
.idea/
